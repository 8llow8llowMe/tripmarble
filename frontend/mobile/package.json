{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:dev": "cross-env APP_ENV=development expo start -c",
    "start:prod": "cross-env APP_ENV=production expo start -c",
    "android:dev": "cross-env APP_ENV=development expo run:android",
    "ios:dev": "cross-env APP_ENV=development expo run:ios",
    "build:dev:android": "cross-env APP_ENV=development eas build -p android --profile development",
    "build:dev:ios": "cross-env APP_ENV=development eas build -p ios --profile development",
    "build:prod:android": "cross-env APP_ENV=production eas build -p android --profile production",
    "build:prod:ios": "cross-env APP_ENV=production eas build -p ios --profile production",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@gorhom/bottom-sheet": "^5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/masked-view": "^0.1.11",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.19",
    "@reduxjs/toolkit": "^2.8.2",
    "@tanstack/react-query": "^5.83.0",
    "@types/redux-persist": "^4.3.1",
    "axios": "^1.10.0",
    "dayjs": "^1.11.13",
    "expo": "^54.0.0",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.60.0",
    "react-native": "0.81.4",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0"
