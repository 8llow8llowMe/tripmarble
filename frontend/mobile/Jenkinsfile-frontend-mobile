pipeline {
    agent any

    // 파라미터
    parameters {
        string(
            name: 'SERVICE_GROUP',
            defaultValue: 'mobile',
            description: '상위 모듈 디렉터리'
        )
        string(
            name: 'SERVICE_NAME',
            defaultValue: 'mobile',
            description: '서비스 이름'
        )
        string(
            name: 'TARGET_BRANCH',
            defaultValue: 'develop',
            description: 'PR 타겟 브랜치 (배포 환경 결정용)'
        )
        string(
            name: 'PR_SHA',
            defaultValue: '',
            description: 'PR 커밋 SHA (빌드할 코드)'
        )
        string(
            name: 'PR_NUMBER',
            defaultValue: '',
            description: 'PR 번호'
        )
    }

    environment {
        FS_PATH = "frontend/${params.SERVICE_GROUP}"
        GRADLE_OPTS = "-Dorg.gradle.daemon=false -Dorg.gradle.parallel=false -Dorg.gradle.configureondemand=false"
        JAVA_OPTS = "-Xmx2g -XX:MaxMetaspaceSize=512m"
    }

    stages {
        stage('Environment Info') {
            steps {
                script {
                    echo "=== Mobile Build Information ==="
                    echo "Branch: ${env.BRANCH_NAME}"
                    echo "Target Branch: ${params.TARGET_BRANCH}"
                    if (params.TARGET_BRANCH == 'main') {
                        env.DEPLOY_ENV = 'prod'
                    } else {
                        env.DEPLOY_ENV = 'dev'
                    }
                }
            }
        }

        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${env.FS_PATH}") {
                    sh 'yarn install --frozen-lockfile'
                }
            }
        }

        stage('Verify Environment') {
            steps {
                dir("${env.FS_PATH}") {
                    script {
                        echo "Verifying environment variables..."
                        sh '''
                            echo "Checking env files:"
                            ls -la env/
                            echo "Development env content:"
                            cat env/.env-frontend-mobile-dev || echo "Dev env file not found"
                            echo "Production env content:"
                            cat env/.env-frontend-mobile-prod || echo "Prod env file not found"
                        '''
                    }
                }
            }
        }

        stage('Prebuild Android') {
            steps {
                dir("${env.FS_PATH}") {
                    script {
                        echo "Running expo prebuild (Managed Workflow)"
                        
                        // Node.js 메모리 설정 및 Expo prebuild
                        sh '''
                            export NODE_OPTIONS="--max-old-space-size=4096"
                            echo "Running expo prebuild with explicit Hermes configuration..."
                            npx expo prebuild --platform android --clean --no-install
                        '''
                        
                        // prebuild 성공 확인
                        sh 'ls -la android/'
                        sh 'test -f android/gradlew && echo "gradlew found" || echo "gradlew NOT found"'
                        sh 'chmod +x android/gradlew'
                        
                        // Android 프로젝트의 gradle.properties 설정 (안정성 우선)
                        sh '''
                            echo "Setting up Android Gradle properties for stability..."
                            cat > android/gradle.properties << EOF
                            org.gradle.daemon=false
                            org.gradle.parallel=false
                            org.gradle.configureondemand=false
                            org.gradle.jvmargs=-Xmx2g -XX:MaxMetaspaceSize=512m -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8
                            org.gradle.caching=false
                            org.gradle.workers.max=1
                            
                            # React Native Hermes configuration (Expo SDK 53 jsEngine)
                            project.ext.react = [
                                enableHermes: true
                            ]
                            EOF
                        '''
                        
                        // Hermes 설정 수정 (간단하고 안전한 방식)
                        sh '''
                            echo "Fixing Hermes configuration for Expo SDK 53 jsEngine..."
                            
                            # app/build.gradle에서 Hermes 설정 수정
                            if [ -f android/app/build.gradle ]; then
                                echo "Found android/app/build.gradle, applying Hermes fixes..."
                                
                                # 1. project.ext.react 블록이 없는 경우 추가
                                if ! grep -q "project.ext.react" android/app/build.gradle; then
                                    echo "Adding project.ext.react configuration..."
                                    cat > temp_react_config.txt << 'EOF'
project.ext.react = [
    enableHermes: true
]

EOF
                                    cat temp_react_config.txt android/app/build.gradle > temp_build.gradle
                                    mv temp_build.gradle android/app/build.gradle
                                    rm temp_react_config.txt
                                fi
                                
                                # 2. hermesEnabled를 enableHermes로 교체
                                echo "Replacing hermesEnabled with enableHermes..."
                                sed -i 's/hermesEnabled/enableHermes/g' android/app/build.gradle
                                
                                # 3. enableHermes 참조를 project.ext.react.enableHermes로 교체 (단순한 방법)
                                echo "Fixing enableHermes references..."
                                sed -i 's/if (enableHermes)/if (project.ext.react.enableHermes)/g' android/app/build.gradle
                                sed -i 's/!enableHermes/!project.ext.react.enableHermes/g' android/app/build.gradle
                                
                                # 4. 변수 선언 제거
                                echo "Removing variable declarations..."
                                sed -i '/def hermesEnabled/d' android/app/build.gradle
                                sed -i '/def enableHermes/d' android/app/build.gradle
                                sed -i '/hermesEnabled =/d' android/app/build.gradle
                                sed -i '/enableHermes =/d' android/app/build.gradle
                                
                                # 5. 수정된 내용 확인
                                echo "Verifying Hermes configuration..."
                                echo "=== Hermes-related lines ==="
                                grep -n "hermesEnabled\\|enableHermes\\|project.ext.react" android/app/build.gradle || echo "No Hermes config found"
                                echo "=== project.ext.react block ==="
                                grep -A 3 "project.ext.react" android/app/build.gradle || echo "project.ext.react block not found"
                            else
                                echo "android/app/build.gradle not found, skipping Hermes configuration"
                            fi
                        '''
                    }
                }
            }
        }

        stage('Setup Keystore') {
            when {
                expression { params.TARGET_BRANCH == 'main' }
            }
            steps {
                dir("${env.FS_PATH}/android") {
                    script {
                        echo "Injecting Android keystore for release build"
                        
                        // Production 빌드용 credentials 설정
                        env.ANDROID_KEYSTORE = credentials('android-keystore')
                        env.ANDROID_KEYSTORE_PASS = credentials('android-keystore-pass')
                        env.ANDROID_KEY_ALIAS = credentials('android-key-alias')
                        env.ANDROID_KEY_PASS = credentials('android-key-pass')

                        sh 'cp ${ANDROID_KEYSTORE} app/keystore.jks'

                        sh '''
                            echo "MYAPP_UPLOAD_STORE_FILE=keystore.jks" >> gradle.properties
                            echo "MYAPP_UPLOAD_KEY_ALIAS=${ANDROID_KEY_ALIAS}" >> gradle.properties
                            echo "MYAPP_UPLOAD_STORE_PASSWORD=${ANDROID_KEYSTORE_PASS}" >> gradle.properties
                            echo "MYAPP_UPLOAD_KEY_PASSWORD=${ANDROID_KEY_PASS}" >> gradle.properties
                        '''
                    }
                }
            }
        }

        stage('Build Android') {
            steps {
                dir("${env.FS_PATH}/android") {
                    script {
                        // gradlew 파일 존재 확인
                        sh 'test -f gradlew || (echo "gradlew not found, listing directory:" && ls -la && exit 1)'
                        sh 'chmod +x gradlew'
                        
                        // Gradle 데몬 완전 비활성화 및 안정성 설정
                        sh '''
                            echo "Cleaning up existing Gradle daemons..."
                            ./gradlew --stop || true
                            pkill -f gradle || true
                            
                            echo "Setting up Gradle properties for maximum stability..."
                            cat > gradle.properties << EOF
                            org.gradle.daemon=false
                            org.gradle.parallel=false
                            org.gradle.configureondemand=false
                            org.gradle.jvmargs=-Xmx2g -XX:MaxMetaspaceSize=512m -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8
                            org.gradle.caching=false
                            org.gradle.workers.max=1
                            EOF
                        '''
                        
                        // 빌드 실행
                        def buildCommand = params.TARGET_BRANCH == 'main' ? 
                            './gradlew clean bundleRelease --no-daemon --no-parallel --max-workers=1 --stacktrace' :
                            './gradlew clean assembleDebug --no-daemon --no-parallel --max-workers=1 --stacktrace'
                        
                        def buildType = params.TARGET_BRANCH == 'main' ? 'signed AAB' : 'debug APK'
                        
                        echo "Building ${buildType}"
                        sh buildCommand
                    }
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                dir("${env.FS_PATH}/android") {
                    script {
                        if (params.TARGET_BRANCH == 'main') {
                            archiveArtifacts artifacts: 'app/build/outputs/bundle/release/*.aab', fingerprint: true
                        } else {
                            archiveArtifacts artifacts: 'app/build/outputs/apk/debug/*.apk', fingerprint: true
                        }
                    }
                }
            }
        }

        stage('Deploy to Play Store') {
            when {
                expression { params.TARGET_BRANCH == 'main' }
            }
            steps {
                dir("${env.FS_PATH}") {
                    script {
                        echo "Deploying AAB to Google Play Store"
                        
                        // Google Play Store credentials 설정
                        env.PLAY_SERVICE_ACCOUNT_JSON = credentials('google-play-service-json')

                        writeFile file: 'google-play-service-account.json', text: "${env.PLAY_SERVICE_ACCOUNT_JSON}"

                        sh '''
                            fastlane supply --aab android/app/build/outputs/bundle/release/app-release.aab \\
                                            --track production \\
                                            --json_key google-play-service-account.json \\
                                            --skip_upload_metadata \\
                                            --skip_upload_images \\
                                            --skip_upload_screenshots
                        '''

                        sh 'rm -f google-play-service-account.json'
                        sh 'rm -f android/app/keystore.jks'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                // Gradle 데몬 정리
                try {
                    dir("${env.FS_PATH}/android") {
                        sh './gradlew --stop || true'
                    }
                } catch (Exception e) {
                    echo "Failed to stop Gradle daemon: ${e.getMessage()}"
                }
                
                if (env.NODE_NAME) {
                    cleanWs()
                }
            }
        }
    }
}