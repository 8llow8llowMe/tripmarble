pipeline {
    agent any

    // 파라미터
    parameters {
        string(
            name: 'SERVICE_GROUP',
            defaultValue: 'mobile',
            description: '상위 모듈 디렉터리'
        )
        string(
            name: 'SERVICE_NAME',
            defaultValue: 'mobile',
            description: '서비스 이름'
        )
        string(
            name: 'TARGET_BRANCH',
            defaultValue: 'develop',
            description: 'PR 타겟 브랜치 (배포 환경 결정용)'
        )
        string(
            name: 'PR_SHA',
            defaultValue: '',
            description: 'PR 커밋 SHA (빌드할 코드)'
        )
        string(
            name: 'PR_NUMBER',
            defaultValue: '',
            description: 'PR 번호'
        )
    }

    // 공통 환경 변수
    environment {
        FS_PATH = "frontend/${params.SERVICE_GROUP}"
        ANDROID_SDK_ROOT = "/opt/android-sdk"
        ANDROID_HOME = "/opt/android-sdk"
        
        // 메모리 설정
        GRADLE_OPTS = "-Xmx768m -XX:MaxMetaspaceSize=384m -Dorg.gradle.daemon=false"
        JAVA_OPTS = "-Xmx768m -XX:MaxMetaspaceSize=384m"
        NODE_OPTIONS = "--max-old-space-size=1536"
        _JAVA_OPTIONS = "-Xmx768m"
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    env.APP_ENV = params.TARGET_BRANCH == 'main' ? 'production' : 'development'
                    env.BUILD_TYPE = params.TARGET_BRANCH == 'main' ? 'release' : 'debug'
                    echo "Building ${env.BUILD_TYPE} for ${env.APP_ENV}"
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: params.PR_SHA ? [[name: params.PR_SHA]] : scm.branches,
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: [[$class: 'SubmoduleOption', recursiveSubmodules: true, parentCredentials: true]]
                ])
            }
        }

        stage('Install') {
            steps {
                dir("${env.FS_PATH}") {
                    sh 'yarn install --frozen-lockfile --network-timeout 100000'
                }
            }
        }

        stage('Verify Environment') {
            steps {
                dir("${env.FS_PATH}") {
                    sh '''
                        if [ "${APP_ENV}" = "production" ]; then
                            ENV_FILE="env/.env-frontend-mobile-prod"
                        else
                            ENV_FILE="env/.env-frontend-mobile-dev"
                        fi
                        
                        if [ -f "$ENV_FILE" ]; then
                            echo "Using environment file: $ENV_FILE"
                        else
                            echo "Environment file not found: $ENV_FILE"
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('Prebuild') {
            steps {
                dir("${env.FS_PATH}") {
                    sh '''
                        export APP_ENV="${APP_ENV}"
                        
                        # Clean and prebuild
                        rm -rf android ios
                        npx expo prebuild --platform android --clean --no-install
                        chmod +x android/gradlew
                        
                        # Fix hermesEnabled - replace variable with true
                        sed -i 's/hermesEnabled/true/g' android/app/build.gradle
                        
                        # gradle.properties - 6GB 스왑 활용 설정
                        cat > android/gradle.properties << EOF
# 메모리 설정 - 스왑 활용
org.gradle.jvmargs=-Xmx768m -XX:MaxMetaspaceSize=384m -XX:+UseG1GC
org.gradle.daemon=false
org.gradle.parallel=false
org.gradle.workers.max=1
org.gradle.configureondemand=false
org.gradle.caching=false

# Android 설정
android.useAndroidX=true
android.enableJetifier=true
EOF
                        
                        # local.properties
                        echo "sdk.dir=/opt/android-sdk" > android/local.properties
                    '''
                }
            }
        }

        stage('Signing') {
            when { expression { env.BUILD_TYPE == 'release' } }
            steps {
                dir("${env.FS_PATH}/android") {
                    withCredentials([
                        file(credentialsId: 'android-keystore', variable: 'KEYSTORE'),
                        string(credentialsId: 'android-keystore-pass', variable: 'KEYSTORE_PASS'),
                        string(credentialsId: 'android-key-alias', variable: 'KEY_ALIAS'),
                        string(credentialsId: 'android-key-pass', variable: 'KEY_PASS')
                    ]) {
                        sh '''
                            cp ${KEYSTORE} app/keystore.jks
                            echo "MYAPP_UPLOAD_STORE_FILE=keystore.jks" >> gradle.properties
                            echo "MYAPP_UPLOAD_KEY_ALIAS=${KEY_ALIAS}" >> gradle.properties
                            echo "MYAPP_UPLOAD_STORE_PASSWORD=${KEYSTORE_PASS}" >> gradle.properties
                            echo "MYAPP_UPLOAD_KEY_PASSWORD=${KEY_PASS}" >> gradle.properties
                        '''
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir("${env.FS_PATH}/android") {
                    script {
                        // Gradle 정리
                        sh './gradlew --stop || true'
                        
                        def buildTask = env.BUILD_TYPE == 'release' ? 'bundleRelease' : 'assembleDebug'
                        
                        sh """
                            # 메모리 상태 확인
                            echo "=== Memory Status ==="
                            free -h
                            
                            # 빌드 실행
                            ./gradlew clean ${buildTask} \\
                                --no-daemon \\
                                --no-parallel \\
                                --max-workers=1 \\
                                -x test \\
                                -x lint \\
                                --info
                        """
                        
                        // 결과 확인
                        sh '''
                            if [ "${BUILD_TYPE}" = "release" ]; then
                                OUTPUT="app/build/outputs/bundle/release/app-release.aab"
                            else
                                OUTPUT="app/build/outputs/apk/debug/app-debug.apk"
                            fi
                            
                            if [ -f "$OUTPUT" ]; then
                                echo "Build successful"
                                ls -lh "$OUTPUT"
                            else
                                echo "Build failed - output not found"
                                exit 1
                            fi
                        '''
                    }
                }
            }
        }

        stage('Archive') {
            steps {
                dir("${env.FS_PATH}/android") {
                    script {
                        if (env.BUILD_TYPE == 'release') {
                            archiveArtifacts artifacts: 'app/build/outputs/bundle/release/*.aab'
                        } else {
                            archiveArtifacts artifacts: 'app/build/outputs/apk/debug/*.apk'
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            when { expression { params.TARGET_BRANCH == 'main' } }
            steps {
                dir("${env.FS_PATH}") {
                    withCredentials([
                        file(credentialsId: 'google-play-service-json', variable: 'PLAY_JSON')
                    ]) {
                        sh '''
                            cp ${PLAY_JSON} google-play-service-account.json
                            
                            fastlane supply \\
                                --aab android/app/build/outputs/bundle/release/app-release.aab \\
                                --track production \\
                                --json_key google-play-service-account.json \\
                                --skip_upload_metadata \\
                                --skip_upload_images \\
                                --skip_upload_screenshots
                            
                            rm -f google-play-service-account.json
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}