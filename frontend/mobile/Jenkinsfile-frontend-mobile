pipeline {
    agent any

    // 파라미터
    parameters {
        string(
            name: 'SERVICE_GROUP',
            defaultValue: 'mobile',
            description: '상위 모듈 디렉터리'
        )
        string(
            name: 'SERVICE_NAME',
            defaultValue: 'mobile',
            description: '서비스 이름'
        )
        string(
            name: 'TARGET_BRANCH',
            defaultValue: 'develop',
            description: 'PR 타겟 브랜치 (배포 환경 결정용)'
        )
        string(
            name: 'PR_SHA',
            defaultValue: '',
            description: 'PR 커밋 SHA (빌드할 코드)'
        )
        string(
            name: 'PR_NUMBER',
            defaultValue: '',
            description: 'PR 번호'
        )
    }

    // 공통 환경 변수
    environment {
        MODULE_PATH = "frontend/${params.SERVICE_GROUP}"
        FS_PATH = "frontend/${params.SERVICE_GROUP}"
        ENV_SUBMODULE = 'frontend/mobile/env'
        DEV_ENV_FILE = "${ENV_SUBMODULE}/.env-frontend-mobile-dev"
        PROD_ENV_FILE = "${ENV_SUBMODULE}/.env-frontend-mobile-prod"
        ANDROID_SDK_ROOT = "/opt/android-sdk"
        ANDROID_HOME = "/opt/android-sdk"
        GRADLE_OPTS = "-Xmx384m -XX:MaxMetaspaceSize=64m -Dorg.gradle.daemon=false"
        NODE_OPTIONS = "--max-old-space-size=384"
    }

    stages {
        stage('Environment Info') {
            steps {
                script {
                    echo "=== Build Information ==="
                    echo "Branch: ${env.BRANCH_NAME}"
                    echo "Service: ${params.SERVICE_NAME}"
                    echo "Target Branch: ${params.TARGET_BRANCH}"
                    echo "PR SHA: ${params.PR_SHA ?: 'Not provided'}"
                    echo "PR Number: ${params.PR_NUMBER ?: 'Not provided'}"
                    
                    // 타겟 브랜치 기준으로 배포 환경 결정
                    if (params.TARGET_BRANCH == 'main') {
                        env.DEPLOY_ENV = 'prod'
                        env.APP_ENV = 'production'
                        env.BUILD_TYPE = 'release'
                        echo "Deploy Target: Production (based on target branch)"
                    } else if (params.TARGET_BRANCH == 'develop') {
                        env.DEPLOY_ENV = 'dev'
                        env.APP_ENV = 'development'
                        env.BUILD_TYPE = 'debug'
                        echo "Deploy Target: Development (based on target branch)"
                    } else {
                        env.DEPLOY_ENV = 'none'
                        env.APP_ENV = 'development'
                        env.BUILD_TYPE = 'debug'
                        echo "Deploy Target: None"
                    }
                    
                    echo "APP_ENV: ${env.APP_ENV}"
                    echo "BUILD_TYPE: ${env.BUILD_TYPE}"
                    echo "========================="
                }
            }
        }

        stage('Checkout Code') {
            steps {
                script {
                    // PR SHA가 있으면 해당 커밋 체크아웃, 없으면 브랜치 HEAD 사용
                    if (params.PR_SHA && params.PR_SHA != '') {
                        echo "Checking out PR commit: ${params.PR_SHA}"
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: params.PR_SHA]],
                            userRemoteConfigs: scm.userRemoteConfigs,
                            extensions: [
                                [$class: 'SubmoduleOption',
                                 recursiveSubmodules: true,
                                 parentCredentials: true]
                            ]
                        ])
                    } else {
                        echo "Using PR branch code (Jenkins 멀티브랜치가 자동으로 PR 브랜치 체크아웃)"
                        checkout([
                            $class: 'GitSCM',
                            branches: scm.branches,
                            userRemoteConfigs: scm.userRemoteConfigs,
                            extensions: [
                                [$class: 'SubmoduleOption',
                                 recursiveSubmodules: true,
                                 parentCredentials: true]
                            ]
                        ])
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${env.FS_PATH}") {
                    sh 'yarn install --frozen-lockfile --network-timeout 100000'
                }
            }
        }

        stage('Verify Environment') {
            steps {
                dir("${env.FS_PATH}") {
                    script {
                        sh '''
                            echo "=== Environment Files Check ==="
                            if [ "${APP_ENV}" = "production" ]; then
                                ENV_FILE="env/.env-frontend-mobile-prod"
                            else
                                ENV_FILE="env/.env-frontend-mobile-dev"
                            fi
                            
                            echo "Looking for environment file: $ENV_FILE"
                            echo "Current directory: $(pwd)"
                            echo "Files in env directory:"
                            ls -la env/ || echo "env directory not found"
                            
                            if [ -f "$ENV_FILE" ]; then
                                echo "Using environment file: $ENV_FILE"
                                echo "Environment variables loaded:"
                                grep "EXPO_PUBLIC_" "$ENV_FILE" | sed 's/=.*/=***/' || true
                            else
                                echo "Environment file not found: $ENV_FILE"
                                exit 1
                            fi
                        '''
                    }
                }
            }
        }

        stage('Build Application') {
            steps {
                dir("${env.FS_PATH}") {
                    sh '''
                        export APP_ENV="${APP_ENV}"
                        
                        # Clean and prebuild
                        rm -rf android ios
                        npx expo prebuild --platform android --clean --no-install
                        chmod +x android/gradlew
                        
                        # Fix hermesEnabled configuration
                        if [ -f android/app/build.gradle ]; then
                            echo "=== Fixing hermesEnabled configuration ==="
                            
                            # Remove all existing react configurations
                            sed -i '/project\\.ext\\.react = \\[/,/^\\]/d' android/app/build.gradle
                            sed -i '/^react {/,/^}/d' android/app/build.gradle
                            
                            # Find the line with apply plugin: "com.facebook.react"
                            PLUGIN_LINE=$(grep -n "apply plugin: \\"com.facebook.react\\"" android/app/build.gradle | cut -d: -f1)
                            
                            if [ ! -z "$PLUGIN_LINE" ]; then
                                # Add react configuration after the plugin line
                                sed -i "${PLUGIN_LINE}a\\
\\
react {\\
    hermesEnabled = true\\
}" android/app/build.gradle
                                echo "Added react configuration after line $PLUGIN_LINE"
                            else
                                echo "Warning: Could not find React plugin line"
                            fi
                            
                            # Also add to gradle.properties as backup
                            echo "hermesEnabled=true" >> android/gradle.properties
                            
                            # Verify the configuration
                            echo "=== Verifying configuration ==="
                            grep -A 3 "react {" android/app/build.gradle || echo "React block not found"
                            grep "hermesEnabled" android/gradle.properties || echo "hermesEnabled not in gradle.properties"
                        fi
                        
                        # Setup gradle.properties
                        cat > android/gradle.properties << EOF
org.gradle.jvmargs=-Xmx384m -XX:MaxMetaspaceSize=64m
org.gradle.daemon=false
org.gradle.parallel=false
org.gradle.workers.max=1
android.useAndroidX=true
android.enableJetifier=true
hermesEnabled=true
newArchEnabled=false
NODE_BINARY=$(which node)
EOF
                        
                        # Setup local.properties for Android SDK
                        cat > android/local.properties << EOF
sdk.dir=/opt/android-sdk
EOF
                        
                        # Verify environment setup
                        echo "=== Environment Verification ==="
                        echo "ANDROID_SDK_ROOT: $ANDROID_SDK_ROOT"
                        echo "ANDROID_HOME: $ANDROID_HOME"
                        echo "NODE_BINARY: $(which node)"
                        echo "GRADLE_OPTS: $GRADLE_OPTS"
                        echo "NODE_OPTIONS: $NODE_OPTIONS"
                        
                        # Verify Android SDK
                        ls -la $ANDROID_SDK_ROOT || echo "Android SDK not found"
                        ls -la $ANDROID_SDK_ROOT/platform-tools || echo "Platform tools not found"
                        
                        # Verify Node.js
                        which node && node --version || echo "Node.js not found"
                        which npm && npm --version || echo "npm not found"
                    '''
                }
            }
        }

        stage('Setup Signing') {
            when { expression { env.BUILD_TYPE == 'release' } }
            steps {
                dir("${env.FS_PATH}/android") {
                    withCredentials([
                        file(credentialsId: 'android-keystore', variable: 'KEYSTORE'),
                        string(credentialsId: 'android-keystore-pass', variable: 'KEYSTORE_PASS'),
                        string(credentialsId: 'android-key-alias', variable: 'KEY_ALIAS'),
                        string(credentialsId: 'android-key-pass', variable: 'KEY_PASS')
                    ]) {
                        sh '''
                            cp ${KEYSTORE} app/keystore.jks
                            echo "MYAPP_UPLOAD_STORE_FILE=keystore.jks" >> gradle.properties
                            echo "MYAPP_UPLOAD_KEY_ALIAS=${KEY_ALIAS}" >> gradle.properties
                            echo "MYAPP_UPLOAD_STORE_PASSWORD=${KEYSTORE_PASS}" >> gradle.properties
                            echo "MYAPP_UPLOAD_KEY_PASSWORD=${KEY_PASS}" >> gradle.properties
                        '''
                    }
                }
            }
        }

        stage('Build Android') {
            steps {
                dir("${env.FS_PATH}/android") {
                    script {
                        // Clean Gradle environment
                        sh '''
                            echo "=== Gradle Environment Setup ==="
                            ./gradlew --stop || true
                            rm -rf ~/.gradle/caches/build-cache-* || true
                            
                            # Set environment variables
                            export ANDROID_SDK_ROOT=$ANDROID_SDK_ROOT
                            export ANDROID_HOME=$ANDROID_HOME
                            export GRADLE_OPTS="$GRADLE_OPTS"
                            export NODE_OPTIONS="$NODE_OPTIONS"
                            
                            # Additional memory optimization
                            export GRADLE_OPTS="$GRADLE_OPTS -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+UseStringDeduplication -XX:+OptimizeStringConcat"
                            
                            # Verify environment
                            echo "ANDROID_SDK_ROOT: $ANDROID_SDK_ROOT"
                            echo "GRADLE_OPTS: $GRADLE_OPTS"
                            echo "NODE_OPTIONS: $NODE_OPTIONS"
                            
                            # Verify gradle.properties
                            echo "=== gradle.properties content ==="
                            cat gradle.properties | grep -E "(hermesEnabled|NODE_BINARY|org.gradle.jvmargs)" || echo "Key properties not found"
                        '''
                        
                        // Build based on type
                        def buildTask = env.BUILD_TYPE == 'release' ? 
                            'bundleRelease' : 'assembleDebug'
                        
                        echo "Building ${env.BUILD_TYPE} (${buildTask})"
                        
                        sh """
                            ./gradlew clean ${buildTask} \\
                                --no-daemon \\
                                --no-parallel \\
                                --max-workers=1 \\
                                --stacktrace \\
                                -x test \\
                                -x lint \\
                                -x check \\
                                -x verify \\
                                -x ktlint \\
                                -x detekt \\
                                -x spotbugs \\
                                --offline \\
                                --no-build-cache
                        """
                        
                        // Verify output
                        sh '''
                            if [ "${BUILD_TYPE}" = "release" ]; then
                                OUTPUT_FILE="app/build/outputs/bundle/release/app-release.aab"
                            else
                                OUTPUT_FILE="app/build/outputs/apk/debug/app-debug.apk"
                            fi
                            
                            if [ -f "$OUTPUT_FILE" ]; then
                                echo "Build successful: $OUTPUT_FILE"
                                ls -lh "$OUTPUT_FILE"
                            else
                                echo "Build output not found"
                                exit 1
                            fi
                        '''
                    }
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'app/build/outputs/**/*', 
                                   fingerprint: true
                }
            }
        }

        stage('Deploy to Dev') {
            when {
                // 타겟 브랜치가 develop인 경우 dev 환경에 배포
                expression { params.TARGET_BRANCH == 'develop' }
            }
            steps {
                script {
                    echo "Deploying ${params.SERVICE_NAME} to Development"
                    
                    // 개발 환경에서는 빌드만 확인하고 배포하지 않음
                    echo "Development deployment skipped - build verification only"
                }
            }
        }

        stage('Deploy to Prod') {
            when {
                // 타겟 브랜치가 main인 경우 prod 환경에 배포
                expression { params.TARGET_BRANCH == 'main' }
            }
            steps {
                dir("${env.FS_PATH}") {
                    script {
                        echo "Deploying ${params.SERVICE_NAME} to Production"
                        echo "Deploying to Google Play Store"
                        
                        withCredentials([
                            file(credentialsId: 'google-play-service-json', variable: 'PLAY_JSON')
                        ]) {
                            sh '''
                                cp ${PLAY_JSON} google-play-service-account.json
                                
                                fastlane supply \
                                    --aab android/app/build/outputs/bundle/release/app-release.aab \
                                    --track production \
                                    --json_key google-play-service-account.json \
                                    --skip_upload_metadata \
                                    --skip_upload_images \
                                    --skip_upload_screenshots
                                
                                # Cleanup
                                rm -f google-play-service-account.json
                                rm -f android/app/keystore.jks
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}