pipeline {
    agent any

    // 파라미터
    parameters {
        string(
            name: 'SERVICE_GROUP',
            defaultValue: 'web',
            description: '상위 모듈 디렉터리'
        )
        string(
            name: 'SERVICE_NAME',
            defaultValue: 'web',
            description: '서비스 이름'
        )
        string(
            name: 'TARGET_BRANCH',
            defaultValue: 'develop',
            description: 'PR 타겟 브랜치 (배포 환경 결정용)'
        )
        string(
            name: 'PR_SHA',
            defaultValue: '',
            description: 'PR 커밋 SHA (빌드할 코드)'
        )
        string(
            name: 'PR_NUMBER',
            defaultValue: '',
            description: 'PR 번호'
        )
    }

    // 공통 환경 변수
    environment {
        MODULE_PATH = "frontend/${params.SERVICE_GROUP}"
        FS_PATH = "frontend/${params.SERVICE_GROUP}"
        DOCKERFILE = "${params.SERVICE_NAME}.Dockerfile"
        COMPOSE_FILE = "docker-compose-${params.SERVICE_NAME}.yml"
        ENV_SUBMODULE = 'frontend/web/env'
        PROD_ENV_FILE = "${ENV_SUBMODULE}/.env-${params.SERVICE_NAME}-ssr-prod"
        REMOTE_DIR = "deploy/tripmarble/frontend-${params.SERVICE_NAME}"
        SSH_CONFIG = 'storage server ssh'
        NEXT_TELEMETRY_DISABLED = '1'
    }

    stages {

        stage('Environment Info') {
            steps {
                script {
                    echo "=== Build Information ==="
                    echo "Branch: ${env.BRANCH_NAME}"
                    echo "Service: ${params.SERVICE_NAME}"
                    echo "Target Branch: ${params.TARGET_BRANCH}"
                    echo "PR SHA: ${params.PR_SHA ?: 'Not provided'}"
                    echo "PR Number: ${params.PR_NUMBER ?: 'Not provided'}"
                    
                    // 타겟 브랜치 기준으로 배포 환경 결정
                    if (params.TARGET_BRANCH == 'main') {
                        env.DEPLOY_ENV = 'prod'
                        echo "Deploy Target: Production (based on target branch)"
                    } else if (params.TARGET_BRANCH == 'develop') {
                        env.DEPLOY_ENV = 'dev'
                        echo "Deploy Target: Development (based on target branch)"
                    } else {
                        env.DEPLOY_ENV = 'none'
                        echo "Deploy Target: None"
                    }
                    echo "========================="
                }
            }
        }

        stage('Checkout Code') {
            steps {
                script {
                    // PR SHA가 있으면 해당 커밋 체크아웃, 없으면 브랜치 HEAD 사용
                    if (params.PR_SHA && params.PR_SHA != '') {
                        echo "Checking out PR commit: ${params.PR_SHA}"
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: params.PR_SHA]],
                            userRemoteConfigs: scm.userRemoteConfigs,
                            extensions: [
                                [$class: 'SubmoduleOption',
                                 recursiveSubmodules: true,
                                 parentCredentials: true]
                            ]
                        ])
                    } else {
                        echo "Using PR branch code (Jenkins 멀티브랜치가 자동으로 PR 브랜치 체크아웃)"
                        checkout([
                            $class: 'GitSCM',
                            branches: scm.branches,
                            userRemoteConfigs: scm.userRemoteConfigs,
                            extensions: [
                                [$class: 'SubmoduleOption',
                                 recursiveSubmodules: true,
                                 parentCredentials: true]
                            ]
                        ])
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${env.FS_PATH}") {
                    sh 'yarn install --frozen-lockfile'
                }
            }
        }

        stage('Build Application') {
            steps {
                dir("${env.FS_PATH}") {
                    script {
                        // Next.js 빌드는 항상 production 모드로 진행 (SSR 안정성 및 최적화)
                        env.NODE_ENV = 'production'
                        if (params.TARGET_BRANCH == 'main') {
                            env.NEXT_PUBLIC_RUNTIME_ENV = 'prod'
                            echo "Building for production runtime"
                        } else {
                            env.NEXT_PUBLIC_RUNTIME_ENV = 'dev'
                            echo "Building for development runtime (build=production)"
                        }
                        sh 'rm -rf .next .turbo || true'
                        // Next.js 빌드
                        sh 'yarn build'
                    }
                }
            }
            post {
                success {
                    // public 리소스를 standalone 경로에도 복사 (SSR 서버 실행에 필요)
                    sh "cp -R ${env.FS_PATH}/public ${env.FS_PATH}/.next/standalone/public || true"
                }
            }
        }

        stage('Deploy to Dev') {
            when {
                // 타겟 브랜치가 develop인 경우 dev 환경에 배포
                expression { params.TARGET_BRANCH == 'develop' }
            }
            steps {
                script {
                    echo "Deploying ${params.SERVICE_NAME} to Development"
                    
                    // 개발 환경에서는 빌드만 확인하고 배포하지 않음
                    echo "Development deployment skipped - build verification only"
                }
            }
        }

        stage('Deploy to Prod') {
            when {
                // 타겟 브랜치가 main인 경우 prod 환경에 배포
                expression { params.TARGET_BRANCH == 'main' }
            }
            steps {
                script {
                    echo "Deploying ${params.SERVICE_NAME} to Production"

                    sshPublisher publishers: [sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [sshTransfer(
                            sourceFiles: """
                                ${PROD_ENV_FILE},
                                ${env.FS_PATH}/.next/standalone/**,
                                ${env.FS_PATH}/.next/static/**,
                                ${env.FS_PATH}/public/**,
                                ${env.FS_PATH}/package.json,
                                ${env.FS_PATH}/${DOCKERFILE},
                                ${env.FS_PATH}/${COMPOSE_FILE}
                            """.trim(),
                            removePrefix: "${env.FS_PATH}",
                            remoteDirectory: REMOTE_DIR,
                            execCommand: """
                                set -x
                                cd ~/${REMOTE_DIR}
                                mkdir -p env
                                mv .env-web-ssr-prod env/.env-web-ssr-prod
            
                                docker compose -f ${COMPOSE_FILE} --env-file env/.env-web-ssr-prod up -d --build
            
                                echo "Frontend web SSR deployment completed successfully"
                            """.stripIndent()
                        )],
                        verbose: true
                    )]
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}