pipeline {
    agent any

    // 파라미터
    parameters {
        // 서비스가 속한 그룹 (폴더명)
        string(
            name: 'SERVICE_GROUP',
            defaultValue: 'web',
            description: '상위 모듈 디렉터리 (web)'
        )
        // 이 파이프라인이 처리할 PR 라벨
        string(
            name: 'SERVICE_LABEL',
            defaultValue: 'frontend-web',
            description: '이 서비스 전용 PR 라벨'
        )
    }

    // 공통 환경 변수
    environment {
        // 실제 파일시스템 경로 ( frontend/web )
        FS_PATH = "frontend/${params.SERVICE_GROUP}"
        // MinIO 설정 (Jenkins 환경변수에서 가져옴, 기본값 fallback)
        MINIO_ENDPOINT = "${env.MINIO_ENDPOINT}"
        MINIO_BUCKET = "${env.MINIO_BUCKET}"
        MINIO_PATH = "frontend/${params.SERVICE_GROUP}"
        // SSH 설정 (MinIO 접근용)
        SSH_CONFIG = 'storage server ssh'
    }

    stages {

        stage('Init & Submodule Update') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: scm.branches,
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: [
                        [$class: 'SubmoduleOption',
                         recursiveSubmodules: true,
                         parentCredentials: true]
                    ]
                ])
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${env.FS_PATH}") {
                    sh 'npm ci'
                }
            }
        }

        stage('Build Test (Dev)') {
            when {
                expression { env.CHANGE_TARGET == 'develop' }
            }
            steps {
                dir("${env.FS_PATH}") {
                    // 개발용 환경변수로 빌드 테스트
                    sh """
                        # 개발용 환경변수 설정
                        export NODE_ENV=development
                        
                        # Next.js 빌드 테스트 (실제 배포는 하지 않음)
                        npm run build
                        
                        echo "개발 환경 빌드 테스트 완료 - 실제 배포는 하지 않음"
                    """
                }
            }
        }

        stage('Build & Deploy to Prod') {
            when {
                expression { env.CHANGE_TARGET == 'main' }
            }
            steps {
                script {
                    dir("${env.FS_PATH}") {
                        // 운영용 환경변수로 빌드
                        sh """
                            # 운영용 환경변수 설정
                            export NODE_ENV=production
                            
                            # Next.js 빌드
                            npm run build
                            
                            echo "운영 환경 빌드 완료"
                        """
                    }
                    
                    // MinIO에 배포
                    withCredentials([usernamePassword(credentialsId: 'minio-credentials',
                                                      usernameVariable: 'MINIO_ACCESS_KEY',
                                                      passwordVariable: 'MINIO_SECRET_KEY')]) {
                        sh """
                            # MinIO Client 설정
                            mc alias set minio ${MINIO_ENDPOINT} ${MINIO_ACCESS_KEY} ${MINIO_SECRET_KEY}
                            
                            # 기존 파일 삭제 (버킷 경로 전체)
                            mc rm --recursive --force minio/${MINIO_BUCKET}/${MINIO_PATH} || true
                            
                            # 새 빌드 파일 업로드
                            mc cp --recursive ${env.FS_PATH}/out/ minio/${MINIO_BUCKET}/${MINIO_PATH}/
                            
                            echo "운영 환경 배포 완료: ${MINIO_ENDPOINT}/${MINIO_BUCKET}/${MINIO_PATH}"
                        """
                    }
                }
            }
            post {
                success {
                    archiveArtifacts "${env.FS_PATH}/out/**/*"
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}