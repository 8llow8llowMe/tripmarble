pipeline {
    agent any

    parameters {
        // 서비스가 속한 그룹 (폴더명)
        choice(
          name: 'SERVICE_GROUP',
          choices: ['service', 'cloud'],
          description: '빌드할 모듈이 있는 상위 디렉토리 (service 또는 cloud 등)'
        )
        // 실제 서비스 이름
        string(
          name: 'SERVICE_NAME',
          defaultValue: 'api-gateway',
          description: '하위 디렉토리명 및 Gradle 식별자'
        )
        // 이 파이프라인이 처리할 PR 라벨
        string(
          name: 'SERVICE_LABEL',
          defaultValue: 'backend-api-gateway',
          description: 'GitHub PR 라벨명'
        )
    }

    environment {
        // Gradle 호출 시 사용하는 모듈 경로 ( :cloud:api-gateway )
        MODULE_PATH = "${params.SERVICE_GROUP}:${params.SERVICE_NAME}"
        // 실제 파일시스템 경로 ( backend/cloud/api-gateway )
        FS_PATH = "backend/${params.SERVICE_GROUP}/${params.SERVICE_NAME}"

        DOCKERFILE = "${params.SERVICE_NAME}.Dockerfile"
        COMPOSE_FILE = "docker-compose-${params.SERVICE_NAME}.yml"

        ENV_SUBMODULE = 'backend/env'
        DEV_ENV_FILE = "${ENV_SUBMODULE}/.env-backend-dev"
        PROD_ENV_FILE = "${ENV_SUBMODULE}/.env-backend-prod"

        REMOTE_DIR = 'deploy/tripmarble/backend-app'
        SSH_CONFIG = 'backend-1 server ssh'
    }

    stages {
        stage('Branch & Label Check') {
            steps {
                script {
                    // 1. 허용 브랜치만 통과
                    def allowed = ['develop', 'main']
                    if (!allowed.contains(env.BRANCH_NAME)) {
                        echo "브랜치 '${env.BRANCH_NAME}' 는 대상 아님. 파이프라인 종료."
                        error("스킵됨: 브랜치 조건 불만족")
                    }

                    // 2. PR 빌드가 아니면 종료
                    if (!env.CHANGE_ID) {
                        echo "PR 빌드가 아님. 파이프라인 종료."
                        error("스킵됨: PR이 아니므로 종료")
                    }

                    // 3. GitHub API로 PR 라벨 조회
                    echo "PR #${env.CHANGE_ID} 의 라벨 검사 시작"
                    def gitUrl = env.GIT_URL ?: error("Git URL 정보 없음")
                    def repoPath = gitUrl
                        .replaceFirst(/^.*github\\.com[:\\/]/, '')
                        .replaceFirst(/\\.git$/, '')

                    withCredentials([usernamePassword(
                        credentialsId: 'deploy',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )]) {
                        def labelsJson = sh(
                            script: """
                              curl -s -H "Authorization: token ${GITHUB_TOKEN}" \\
                                   https://api.github.com/repos/${repoPath}/issues/${env.CHANGE_ID}/labels
                            """,
                            returnStdout: true
                        ).trim()

                        def want = "\"name\": \"${params.SERVICE_LABEL}\""
                        if (!labelsJson.contains(want)) {
                            echo "PR에 '${params.SERVICE_LABEL}' 라벨 없음. 파이프라인 종료."
                            error("스킵됨: 라벨 조건 불만족")
                        }
                    }

                    echo "모든 조건 통과. 이후 단계 진행."
                }
            }
        }

        stage('Init & Submodule Update') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: scm.branches,
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: [[
                        $class: 'SubmoduleOption',
                        recursiveSubmodules: true,
                        parentCredentials: true
                    ]]
                ])
            }
        }

        stage('Build JAR') {
            steps {
                dir("${env.FS_PATH}") {
                    sh 'chmod +x ../../gradlew'
                    sh "../../gradlew :${env.MODULE_PATH}:bootJar"
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: "${env.FS_PATH}/build/libs/*.jar"
                }
            }
        }

        stage('Deploy to Dev') {
            when { branch 'develop' }
            steps {
                script {
                    sshPublisher publishers: [ sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [ sshTransfer(
                            sourceFiles: "${DEV_ENV_FILE}",
                            removePrefix: 'backend/env',
                            remoteDirectory: REMOTE_DIR
                        ) ],
                        verbose: true
                    ) ]

                    sshPublisher publishers: [ sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [ sshTransfer(
                            sourceFiles: """
                              ${env.FS_PATH}/build/libs/*.jar,
                              ${env.FS_PATH}/${DOCKERFILE},
                              ${env.FS_PATH}/${COMPOSE_FILE}
                            """.trim(),
                            removePrefix: "${env.FS_PATH}",
                            remoteDirectory: REMOTE_DIR,
                            execCommand: """
                              set -x
                              cd ~/${REMOTE_DIR}
                              mkdir -p env
                              mv .env-backend-dev env/.env-backend-dev
                              docker compose -f ${COMPOSE_FILE} \\
                                --env-file env/.env-backend-dev \\
                                up -d --build ${params.SERVICE_NAME}-dev
                            """.stripIndent()
                        ) ],
                        verbose: true
                    ) ]
                }
            }
        }

        stage('Deploy to Prod') {
            when { branch 'main' }
            steps {
                script {
                    sshPublisher publishers: [ sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [ sshTransfer(
                            sourceFiles: "${PROD_ENV_FILE}",
                            removePrefix: 'backend/env',
                            remoteDirectory: REMOTE_DIR
                        ) ],
                        verbose: true
                    ) ]

                    sshPublisher publishers: [ sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [ sshTransfer(
                            sourceFiles: """
                              ${env.FS_PATH}/build/libs/*.jar,
                              ${env.FS_PATH}/${DOCKERFILE},
                              ${env.FS_PATH}/${COMPOSE_FILE}
                            """.trim(),
                            removePrefix: "${env.FS_PATH}",
                            remoteDirectory: REMOTE_DIR,
                            execCommand: """
                              set -x
                              cd ~/${REMOTE_DIR}
                              mkdir -p env
                              mv .env-backend-prod env/.env-backend-prod
                              docker compose -f ${COMPOSE_FILE} \\
                                --env-file env/.env-backend-prod \\
                                up -d --build ${params.SERVICE_NAME}-prod
                            """.stripIndent()
                        ) ],
                        verbose: true
                    ) ]
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
