pipeline {
    agent any

    // 파라미터
    parameters {
        // 서비스가 속한 그룹 (폴더명)
        string(
            name: 'SERVICE_GROUP',
            defaultValue: 'cloud',
            description: '상위 모듈 디렉터리 (cloud)'
        )
        // 실제 서비스 이름
        string(
            name: 'SERVICE_NAME',
            defaultValue: 'service-discovery',
            description: '하위 모듈(서비스) 디렉터리 이름'
        )
        // 이 파이프라인이 처리할 PR 라벨
        string(
            name: 'SERVICE_LABEL',
            defaultValue: 'backend-service-discovery',
            description: '이 서비스 전용 PR 라벨'
        )
        // GitHub Action에서 전달받는 타겟 브랜치
        string(
            name: 'TARGET_BRANCH',
            defaultValue: '',
            description: 'PR의 타겟 브랜치 (GitHub Action에서 전달)'
        )
        // 배포 환경
        string(
            name: 'DEPLOY_ENV',
            defaultValue: 'dev',
            description: '배포 환경 (dev/prod)'
        )
    }

    // 공통 환경 변수
    environment {
        // Gradle 호출 시 사용하는 모듈 경로 ( cloud:service-discovery )
        MODULE_PATH = "${params.SERVICE_GROUP}:${params.SERVICE_NAME}"
        // 실제 파일시스템 경로 ( backend/cloud/service-discovery )
        FS_PATH = "backend/${params.SERVICE_GROUP}/${params.SERVICE_NAME}"
        DOCKERFILE = "${params.SERVICE_NAME}.Dockerfile"
        COMPOSE_FILE = "docker-compose-${params.SERVICE_NAME}.yml"
        ENV_SUBMODULE = 'backend/env'
        DEV_ENV_FILE = "${ENV_SUBMODULE}/.env-backend-dev"
        PROD_ENV_FILE = "${ENV_SUBMODULE}/.env-backend-prod"
        REMOTE_DIR = 'deploy/tripmarble/backend-app'
        SSH_CONFIG = 'backend-1 server ssh'
    }

    stages {

        stage('Environment Info') {
            steps {
                script {
                    echo "=== Build Environment Information ==="
                    echo "BRANCH_NAME: ${env.BRANCH_NAME}"
                    echo "CHANGE_TARGET: ${env.CHANGE_TARGET}"
                    echo "CHANGE_ID: ${env.CHANGE_ID}"
                    echo "TARGET_BRANCH param: ${params.TARGET_BRANCH}"
                    echo "DEPLOY_ENV param: ${params.DEPLOY_ENV}"
                    echo "SERVICE_NAME: ${params.SERVICE_NAME}"
                    echo "=================================="
                }
            }
        }

        stage('Init & Submodule Update') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: scm.branches,
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: [
                        [$class: 'SubmoduleOption',
                         recursiveSubmodules: true,
                         parentCredentials: true]
                    ]
                ])
            }
        }

        stage('Build JAR') {
            steps {
                dir("${env.FS_PATH}") {
                    sh 'chmod +x ../../gradlew'
                    sh "../../gradlew :${env.MODULE_PATH}:bootJar"
                }
            }
            post {
                success {
                    archiveArtifacts "${env.FS_PATH}/build/libs/*.jar"
                }
            }
        }

        stage('Deploy to Dev') {
            when {
                anyOf {
                    // PR을 develop에 머지하는 경우
                    expression { env.CHANGE_TARGET == 'develop' }
                    // develop 브랜치에서 직접 빌드하는 경우
                    expression { env.BRANCH_NAME == 'develop' }
                    // GitHub Action에서 전달받은 타겟 브랜치가 develop인 경우
                    expression { params.TARGET_BRANCH == 'develop' }
                    // 배포 환경 파라미터가 dev인 경우
                    expression { params.DEPLOY_ENV == 'dev' }
                }
            }
            steps {
                script {
                    echo "Deploying ${params.SERVICE_NAME} to Development environment"
                    
                    // 환경 파일 전송
                    sshPublisher publishers: [sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [sshTransfer(
                            sourceFiles: "${DEV_ENV_FILE}",
                            removePrefix: 'backend/env',
                            remoteDirectory: REMOTE_DIR
                        )],
                        verbose: true
                    )]
                    
                    // 애플리케이션 파일 전송 및 배포
                    sshPublisher publishers: [sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [sshTransfer(
                            sourceFiles: """
                                ${env.FS_PATH}/build/libs/*.jar,
                                ${env.FS_PATH}/${DOCKERFILE},
                                ${env.FS_PATH}/${COMPOSE_FILE}
                            """.trim(),
                            removePrefix: "${env.FS_PATH}",
                            remoteDirectory: REMOTE_DIR,
                            execCommand: """
                                set -x
                                cd ~/${REMOTE_DIR}
                                mkdir -p env
                                mv .env-backend-dev env/.env-backend-dev
                                docker compose -f ${COMPOSE_FILE} \\
                                    --env-file env/.env-backend-dev \\
                                    up -d --build ${params.SERVICE_NAME}-dev
                            """.stripIndent()
                        )],
                        verbose: true
                    )]
                }
            }
        }

        stage('Deploy to Prod') {
            when {
                anyOf {
                    expression { env.CHANGE_TARGET == 'main' }
                    expression { env.BRANCH_NAME == 'main' }
                }
            }
            steps {
                script {
                    sshPublisher publishers: [sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [sshTransfer(
                            sourceFiles: "${PROD_ENV_FILE}",
                            removePrefix: 'backend/env',
                            remoteDirectory: REMOTE_DIR
                        )],
                        verbose: true
                    )]
                    sshPublisher publishers: [sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [sshTransfer(
                            sourceFiles: """
                                ${env.FS_PATH}/build/libs/*.jar,
                                ${env.FS_PATH}/${DOCKERFILE},
                                ${env.FS_PATH}/${COMPOSE_FILE}
                            """.trim(),
                            removePrefix: "${env.FS_PATH}",
                            remoteDirectory: REMOTE_DIR,
                            execCommand: """
                                set -x
                                cd ~/${REMOTE_DIR}
                                mkdir -p env
                                mv .env-backend-prod env/.env-backend-prod
                                docker compose -f ${COMPOSE_FILE} \\
                                    --env-file env/.env-backend-prod \\
                                    up -d --build ${params.SERVICE_NAME}-prod
                            """.stripIndent()
                        )],
                        verbose: true
                    )]
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
