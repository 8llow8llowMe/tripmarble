pipeline {
    agent any

    parameters {
        string(name: 'SERVICE_NAME', defaultValue: 'service-discovery', description: '서비스 디렉토리명 및 식별자')
        string(name: 'SERVICE_LABEL', defaultValue: 'backend-service-discovery', description: 'GitHub PR 라벨명')
    }

    environment {
        DOCKERFILE = "${params.SERVICE_NAME}.Dockerfile"
        COMPOSE_FILE = "docker-compose-${params.SERVICE_NAME}.yml"

        ENV_SUBMODULE = 'backend/env'
        DEV_ENV_FILE = "${ENV_SUBMODULE}/.env-backend-dev"
        PROD_ENV_FILE = "${ENV_SUBMODULE}/.env-backend-prod"

        REMOTE_DIR = 'deploy/tripmarble/backend-app'
        SSH_CONFIG = 'backend-1 server ssh'
    }

    stages {
        stage('Branch Check') {
            steps {
                script {
                    def allowedBranches = ['develop', 'main']
                    if (!allowedBranches.contains(env.BRANCH_NAME)) {
                        echo "브랜치 '${env.BRANCH_NAME}' 는 대상 아님. 종료."
                        currentBuild.result = 'SUCCESS'
                        error("스킵됨: 브랜치 조건 불만족")
                    }

                    if (env.CHANGE_ID) {
                        echo "PR 라벨 검사 시작"

                        def gitUrl = env.GIT_URL ?: ''
                        def repoPath = ''
                        if (gitUrl.contains('github.com')) {
                            repoPath = gitUrl.replaceFirst(/^.*github\.com[:\/]/, '').replaceFirst(/\.git$/, '')
                        } else {
                            error("GitHub 저장소가 아님: ${gitUrl}")
                        }

                        withCredentials([usernamePassword(credentialsId: 'deploy', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
                            def labelsJson = sh(
                                script: """
                                    curl -s -H "Authorization: token ${GITHUB_TOKEN}" \\
                                        https://api.github.com/repos/${repoPath}/issues/${env.CHANGE_ID}/labels
                                """,
                                returnStdout: true
                            ).trim()

                            def requiredLabel = "\"name\": \"${params.SERVICE_LABEL}\""
                            if (!labelsJson.contains(requiredLabel)) {
                                echo "PR에 '${params.SERVICE_LABEL}' 라벨 없음. 종료"
                                currentBuild.result = 'SUCCESS'
                                error("스킵됨: 라벨 조건 불만족")
                            } else {
                                echo "라벨 조건 통과: ${params.SERVICE_LABEL}"
                            }
                        }
                    } else {
                        echo "PR 아님 (develop/main 머지 시 등), 라벨 체크 생략"
                    }
                }
            }
        }

        stage('Init & Submodule Update') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: scm.branches,
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: [[
                        $class: 'SubmoduleOption',
                        recursiveSubmodules: true,
                        parentCredentials: true
                    ]]
                ])
            }
        }

        stage('Build JAR') {
            steps {
                dir("backend/service/${params.SERVICE_NAME}") {
                    sh 'chmod +x ../../gradlew'
                    sh "../../gradlew :service:${params.SERVICE_NAME}:bootJar"
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: "backend/service/${params.SERVICE_NAME}/build/libs/*.jar"
                }
            }
        }

        stage('Deploy to Dev') {
            when { branch 'develop' }
            steps {
                script {
                    sshPublisher publishers: [ sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [ sshTransfer(
                            sourceFiles: "${DEV_ENV_FILE}",
                            removePrefix: 'backend/env',
                            remoteDirectory: REMOTE_DIR
                        ) ],
                        verbose: true
                    ) ]

                    sshPublisher publishers: [ sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [ sshTransfer(
                            sourceFiles: """
                                backend/service/${params.SERVICE_NAME}/build/libs/*.jar,
                                backend/service/${params.SERVICE_NAME}/${DOCKERFILE},
                                backend/service/${params.SERVICE_NAME}/${COMPOSE_FILE}
                            """.trim(),
                            removePrefix: "backend/service/${params.SERVICE_NAME}",
                            remoteDirectory: REMOTE_DIR,
                            execCommand: """
                                set -x
                                cd ~/${REMOTE_DIR}
                                mkdir -p env
                                mv .env-backend-dev env/.env-backend-dev
                                docker compose -f ${COMPOSE_FILE} \\
                                  --env-file env/.env-backend-dev \\
                                  up -d --build ${params.SERVICE_NAME}-dev
                            """.stripIndent()
                        ) ],
                        verbose: true
                    ) ]
                }
            }
        }

        stage('Deploy to Prod') {
            when { branch 'main' }
            steps {
                script {
                    sshPublisher publishers: [ sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [ sshTransfer(
                            sourceFiles: "${PROD_ENV_FILE}",
                            removePrefix: 'backend/env',
                            remoteDirectory: REMOTE_DIR
                        ) ],
                        verbose: true
                    ) ]

                    sshPublisher publishers: [ sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [ sshTransfer(
                            sourceFiles: """
                                backend/service/${params.SERVICE_NAME}/build/libs/*.jar,
                                backend/service/${params.SERVICE_NAME}/${DOCKERFILE},
                                backend/service/${params.SERVICE_NAME}/${COMPOSE_FILE}
                            """.trim(),
                            removePrefix: "backend/service/${params.SERVICE_NAME}",
                            remoteDirectory: REMOTE_DIR,
                            execCommand: """
                                set -x
                                cd ~/${REMOTE_DIR}
                                mkdir -p env
                                mv .env-backend-prod env/.env-backend-prod
                                docker compose -f ${COMPOSE_FILE} \\
                                  --env-file env/.env-backend-prod \\
                                  up -d --build ${params.SERVICE_NAME}-prod
                            """.stripIndent()
                        ) ],
                        verbose: true
                    ) ]
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
