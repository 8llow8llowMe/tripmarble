pipeline {
    agent { label 'backend' }   // 에이전트 라벨

    // 빌드/아티팩트 보존 전략 (모든 브랜치에 적용되지만, 아티팩트는 main에서만 생성)
    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(
            daysToKeepStr: '30', // 빌드 로그 30일 보관
            numToKeepStr: '50', // 빌드 50개 보관
            artifactDaysToKeepStr: '14', // 아티팩트는 14일 보관
            artifactNumToKeepStr: '20' // 아티팩트 20개 보관
        ))
    }

    parameters {
        string(
            name: 'SERVICE_GROUP',
            defaultValue: 'service',
            description: '상위 모듈 디렉터리'
        )
        string(
            name: 'SERVICE_NAME',
            defaultValue: 'trip-service',
            description: '서비스 이름'
        )
        string(
            name: 'TARGET_BRANCH',
            defaultValue: 'develop',
            description: 'PR 타겟 브랜치 (배포 환경 결정용)'
        )
        string(
            name: 'PR_NUMBER',
            defaultValue: '',
            description: 'PR 번호'
        )
    }

    environment {
        BACKEND_DIR = 'backend'
        MODULE_PATH = "${params.SERVICE_GROUP}:${params.SERVICE_NAME}"
        FS_PATH = "backend/${params.SERVICE_GROUP}/${params.SERVICE_NAME}"
        DOCKERFILE = "${params.SERVICE_NAME}.Dockerfile"
        COMPOSE_FILE = "docker-compose-${params.SERVICE_NAME}.yml"
        ENV_SUBMODULE = 'backend/env'
        DEV_ENV_FILE = "${ENV_SUBMODULE}/.env-backend-dev"
        PROD_ENV_FILE = "${ENV_SUBMODULE}/.env-backend-prod"
        REMOTE_DIR = 'deploy/tripmarble/backend-app'
    }

    stages {
        stage('Env Info') {
            steps {
                script {
                    echo "BRANCH_NAME: ${env.BRANCH_NAME}"
                    echo "SERVICE: ${params.SERVICE_NAME}"
                    echo "TARGET_BRANCH(base): ${params.TARGET_BRANCH}"
                    env.DEPLOY_ENV = (params.TARGET_BRANCH == 'main') ? 'prod' :
                                     (params.TARGET_BRANCH == 'develop') ? 'dev' : 'none'
                    echo "DEPLOY_ENV: ${env.DEPLOY_ENV}"
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: scm.branches,
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [
                        [$class: 'SubmoduleOption',
                         disableSubmodules: false,
                         recursiveSubmodules: true, // 모든 하위 submodule 포함
                         parentCredentials: true, // Jenkins 자격증명 재사용
                         reference: '',
                         trackingSubmodules: false]
                    ],
                    userRemoteConfigs: scm.userRemoteConfigs
                ])
            }
        }

        stage('Build JAR') {
            steps {
                dir("${env.BACKEND_DIR}") {
                    sh "chmod +x gradlew"
                    sh """
                      ./gradlew :${env.MODULE_PATH}:bootJar \
                        --no-daemon --parallel --build-cache --stacktrace
                    """
                }
            }
        }

        stage('Archive (main only)') {
            when { expression { params.TARGET_BRANCH == 'main' } }
            steps {
                archiveArtifacts artifacts: "${env.FS_PATH}/build/libs/*.jar",
                fingerprint: true,
                onlyIfSuccessful: true
            }
        }

        stage('Deploy Dev (develop only)') {
            when { expression { params.TARGET_BRANCH == 'develop' } }
            steps {
                sh """
                  set -eux
                  mkdir -p ~/${REMOTE_DIR}/env
                  cp ${DEV_ENV_FILE} ~/${REMOTE_DIR}/env/.env-backend-dev
                  cp ${env.FS_PATH}/build/libs/*.jar ~/${REMOTE_DIR}/
                  cp ${env.FS_PATH}/${DOCKERFILE} ~/${REMOTE_DIR}/
                  cp ${env.FS_PATH}/${COMPOSE_FILE} ~/${REMOTE_DIR}/
                  cd ~/${REMOTE_DIR}
                  docker compose -f ${COMPOSE_FILE} --env-file env/.env-backend-dev \
                    up -d --build ${params.SERVICE_NAME}-dev
                """
            }
        }

        stage('Deploy Prod (main only)') {
            when { expression { params.TARGET_BRANCH == 'main' } }
            steps {
                sh """
                  set -eux
                  mkdir -p ~/${REMOTE_DIR}/env
                  cp ${PROD_ENV_FILE} ~/${REMOTE_DIR}/env/.env-backend-prod
                  cp ${env.FS_PATH}/build/libs/*.jar ~/${REMOTE_DIR}/
                  cp ${env.FS_PATH}/${DOCKERFILE} ~/${REMOTE_DIR}/
                  cp ${env.FS_PATH}/${COMPOSE_FILE} ~/${REMOTE_DIR}/
                  cd ~/${REMOTE_DIR}
                  docker compose -f ${COMPOSE_FILE} --env-file env/.env-backend-prod \
                    up -d --build ${params.SERVICE_NAME}-prod
                """
            }
        }
    }

    post {
        always { cleanWs() }
    }
}
