pipeline {
    agent any

    // 파라미터
    parameters {
        // 서비스가 속한 그룹 (폴더명)
        string(
            name: 'SERVICE_GROUP',
            defaultValue: 'service',
            description: '상위 모듈 디렉터리 (service)'
        )
        // 실제 서비스 이름
        string(
            name: 'SERVICE_NAME',
            defaultValue: 'trip-service',
            description: '하위 모듈(서비스) 디렉터리 이름'
        )
        // 이 파이프라인이 처리할 PR 라벨
        string(
            name: 'SERVICE_LABEL',
            defaultValue: 'backend-trip-service',
            description: '이 서비스 전용 PR 라벨'
        )
    }

    // 공통 환경 변수
    environment {
        // Gradle 호출 시 사용하는 모듈 경로 ( service:trip-service )
        MODULE_PATH = "${params.SERVICE_GROUP}:${params.SERVICE_NAME}"
        // 실제 파일시스템 경로 ( backend/service/trip-service )
        FS_PATH = "backend/${params.SERVICE_GROUP}/${params.SERVICE_NAME}"

        DOCKERFILE = "${params.SERVICE_NAME}.Dockerfile"
        COMPOSE_FILE = "docker-compose-${params.SERVICE_NAME}.yml"

        ENV_SUBMODULE = 'backend/env'
        DEV_ENV_FILE = "${ENV_SUBMODULE}/.env-backend-dev"
        PROD_ENV_FILE = "${ENV_SUBMODULE}/.env-backend-prod"

        REMOTE_DIR = 'deploy/tripmarble/backend-app'
        SSH_CONFIG = 'backend-1 server ssh'
    }

    stages {
        stage('Branch & Label Check') {
            steps {
                script {
                    boolean isPR = env.CHANGE_ID ? true : false

                    // 1. 브랜치 제한 (develop / main 또는 PR)
                    if (!isPR) { // PR 빌드가 아니면
                        def allowed = ['develop', 'main']
                        if (!allowed.contains(env.BRANCH_NAME)) {
                            echo "대상 브랜치 아님(${env.BRANCH_NAME}). 작업 건너뜀."
                            currentBuild.result = 'SUCCESS'  // 조용히 성공 종료
                            return // 파이프라인 종료
                        }
                    }

                    // 2. PR 번호 확보
                    String prNum = env.CHANGE_ID
                    if (!prNum) {
                        // Merge-commit 패턴
                        String msg = sh(script: "git log -1 --pretty=%B", returnStdout: true).trim()
                        String foundPrNum = null
                        def matcher1 = (msg =~ /Merge pull request #(\\d+)/)
                        if (matcher1.find()) {
                            foundPrNum = matcher1[0][1]
                        }
                        matcher1 = null // 명시적으로 제거

                        if (!prNum && foundPrNum) {
                            prNum = foundPrNum
                        }

                        // rebase-merge 패턴
                        if (!prNum) {
                            String sha = sh(script: "git rev-parse HEAD", returnStdout: true).trim()
                            def repo = (env.GIT_URL ?: '').replaceFirst(/^.*github.com[:\\/]/,'').replaceFirst(/\\.git$/,'')
                            withCredentials([usernamePassword(credentialsId: 'deploy',
                                                              usernameVariable: 'GH_USER',
                                                              passwordVariable: 'GH_TOKEN')]) {
                                String prsJson = sh(
                                    script: """
                                        curl -s -H "Authorization: token ${GH_TOKEN}" \\
                                             -H "Accept: application/vnd.github.groot-preview+json" \\
                                             https://api.github.com/repos/${repo}/commits/${sha}/pulls
                                    """,
                                    returnStdout: true
                                ).trim()

                                def matcher2 = (prsJson =~ /"number":\\s*(\\d+)/)
                                if (matcher2.find()) {
                                    prNum = matcher2[0][1]
                                }
                                matcher2 = null // 역시 명시적으로 제거
                            }
                        }
                    }

                    if (!prNum) {
                        echo "PR 번호를 찾지 못했으므로 빌드 중단."
                        error('skip: PR Number not found')
                    }

                    // 3. 라벨 검사
                    echo "PR #${prNum} 라벨 검사"
                    def repoPath = (env.GIT_URL ?: '').replaceFirst(/^.*github.com[:\\/]/,'').replaceFirst(/\\.git$/,'')
                    boolean labelOk = false
                    withCredentials([usernamePassword(credentialsId: 'deploy',
                                                      usernameVariable: 'GH_USER',
                                                      passwordVariable: 'GH_TOKEN')]) {
                        def labelsJson = sh(
                             script: """
                                curl -s -H "Authorization: token ${GH_TOKEN}" \\
                                     https://api.github.com/repos/${repoPath}/issues/${prNum}/labels
                             """,
                             returnStdout: true).trim()
                        labelOk = labelsJson.contains("\"name\": \"${params.SERVICE_LABEL}\"")
                    }
                    if (!labelOk) {
                        echo "'${params.SERVICE_LABEL}' 라벨 없음. 빌드 중단."
                        error('skip: label mismatch')
                    }

                    echo "라벨 일치. 파이프라인 계속 진행."
                }
            }
        }

        stage('Init & Submodule Update') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: scm.branches,
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: [[
                        $class: 'SubmoduleOption',
                        recursiveSubmodules: true,
                        parentCredentials: true
                    ]]
                ])
            }
        }

        stage('Build JAR') {
            steps {
                dir("${env.FS_PATH}") {
                    sh 'chmod +x ../../gradlew'
                    sh "../../gradlew :${env.MODULE_PATH}:bootJar"
                }
            }
            post { success { archiveArtifacts "${env.FS_PATH}/build/libs/*.jar" } }
        }

        stage('Deploy to Dev') {
            when { branch 'develop' }
            steps {
                script {
                    sshPublisher publishers: [sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [sshTransfer(
                            sourceFiles: "${DEV_ENV_FILE}",
                            removePrefix: 'backend/env',
                            remoteDirectory: REMOTE_DIR
                        )],
                        verbose: true)]

                    sshPublisher publishers: [sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [sshTransfer(
                            sourceFiles: """
                               ${env.FS_PATH}/build/libs/*.jar,
                               ${env.FS_PATH}/${DOCKERFILE},
                               ${env.FS_PATH}/${COMPOSE_FILE}
                            """.trim(),
                            removePrefix: "${env.FS_PATH}",
                            remoteDirectory: REMOTE_DIR,
                            execCommand: """
                               set -x
                               cd ~/${REMOTE_DIR}
                               mkdir -p env
                               mv .env-backend-dev env/.env-backend-dev
                               docker compose -f ${COMPOSE_FILE} \\
                                  --env-file env/.env-backend-dev \\
                                  up -d --build ${params.SERVICE_NAME}-dev
                            """.stripIndent()
                        )],
                        verbose: true)]
                }
            }
        }

        stage('Deploy to Prod') {
            when { branch 'main' }
            steps {
                script {
                    sshPublisher publishers: [sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [sshTransfer(
                            sourceFiles: "${PROD_ENV_FILE}",
                            removePrefix: 'backend/env',
                            remoteDirectory: REMOTE_DIR
                        )],
                        verbose: true)]

                    sshPublisher publishers: [sshPublisherDesc(
                        configName: SSH_CONFIG,
                        transfers: [sshTransfer(
                            sourceFiles: """
                               ${env.FS_PATH}/build/libs/*.jar,
                               ${env.FS_PATH}/${DOCKERFILE},
                               ${env.FS_PATH}/${COMPOSE_FILE}
                            """.trim(),
                            removePrefix: "${env.FS_PATH}",
                            remoteDirectory: REMOTE_DIR,
                            execCommand: """
                               set -x
                               cd ~/${REMOTE_DIR}
                               mkdir -p env
                               mv .env-backend-prod env/.env-backend-prod
                               docker compose -f ${COMPOSE_FILE} \\
                                  --env-file env/.env-backend-prod \\
                                  up -d --build ${params.SERVICE_NAME}-prod
                            """.stripIndent()
                        )],
                        verbose: true)]
                }
            }
        }
    }

    post { always { cleanWs() } }
}
