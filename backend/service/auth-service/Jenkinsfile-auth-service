pipeline {
    agent any

    environment {
        // 서비스 명 및 파일 이름
        SERVICE_NAME    = 'auth-service'
        DOCKERFILE      = 'auth-service.Dockerfile'
        COMPOSE_FILE    = 'docker-compose-auth-service.yml'

        // Submodule 경로 (워크스페이스 상대)
        ENV_SUBMODULE   = 'backend/env'
        DEV_ENV_FILE    = "${ENV_SUBMODULE}/.env-backend-dev"
        PROD_ENV_FILE   = "${ENV_SUBMODULE}/.env-backend-prod"

        // 배포 서버 설정
        REMOTE_DIR      = 'deploy/tripmarble/backend-app'
        SSH_CONFIG      = 'BackEnd Server SSH'
    }

    stages {
        stage('Init & Submodule Update') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: scm.branches,
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: [
                        // parentCredentials로 private 서브모듈 인증 전달
                        [$class: 'SubmoduleOption',
                         recursiveSubmodules: true,
                         parentCredentials: true,
                         trackingSubmodules: false]
                    ]
                ])
            }
        }

        stage('Build JAR') {
            steps {
                dir('backend/service/auth-service') {
                    sh 'chmod +x ../../gradlew'
                    sh '../../gradlew :service:auth-service:bootJar'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'backend/service/auth-service/build/libs/*.jar',
                                     allowEmptyArchive: false
                }
            }
        }

        stage('Deploy to Dev') {
            when { branch 'develop' }
            steps {
                script {
                    // 1) 로컬 파일 존재 여부 확인
                    echo "=== LOCAL .env-backend-dev path ==="
                    echo "DEV_ENV_FILE = ${DEV_ENV_FILE}"
                    sh "ls -la ${ENV_SUBMODULE} || true"

                    // 2) SSH 전송 & 원격 복사
                    sshPublisher publishers: [
                        sshPublisherDesc(
                            configName: SSH_CONFIG,
                            transfers: [
                                sshTransfer(
                                    sourceFiles: """
                                        backend/service/${SERVICE_NAME}/build/libs/*.jar,
                                        backend/service/${SERVICE_NAME}/${DOCKERFILE},
                                        backend/service/${SERVICE_NAME}/${COMPOSE_FILE},
                                        ${DEV_ENV_FILE}
                                    """.trim(),
                                    remoteDirectory: REMOTE_DIR,
                                    execCommand: """
                                      set -x
                                      cd ~/${REMOTE_DIR}
                                      echo '=== REMOTE BEFORE MV ==='
                                      ls -la .
                                      mkdir -p env
                                      echo 'mv .env-backend-dev → env/.env-backend-dev'
                                      mv .env-backend-dev env/.env-backend-dev
                                      echo '=== REMOTE AFTER MV ==='
                                      ls -la env
                                      echo '=== START DOCKER COMPOSE ==='
                                      docker compose -f ${COMPOSE_FILE} \\
                                        --env-file env/.env-backend-dev \\
                                        up -d --build ${SERVICE_NAME}-dev
                                    """.stripIndent()
                                )
                            ],
                            verbose: true
                        )
                    ]
                }
            }
        }

        stage('Deploy to Prod') {
            when { branch 'main' }
            steps {
                script {
                    echo "=== LOCAL .env-backend-prod path ==="
                    echo "PROD_ENV_FILE = ${PROD_ENV_FILE}"
                    sh "ls -la ${ENV_SUBMODULE} || true"

                    sshPublisher publishers: [
                        sshPublisherDesc(
                            configName: SSH_CONFIG,
                            transfers: [
                                sshTransfer(
                                    sourceFiles: """
                                        backend/service/${SERVICE_NAME}/build/libs/*.jar,
                                        backend/service/${SERVICE_NAME}/${DOCKERFILE},
                                        backend/service/${SERVICE_NAME}/${COMPOSE_FILE},
                                        ${PROD_ENV_FILE}
                                    """.trim(),
                                    remoteDirectory: REMOTE_DIR,
                                    execCommand: """
                                      set -x
                                      cd ~/${REMOTE_DIR}
                                      echo '=== REMOTE BEFORE MV ==='
                                      ls -la .
                                      mkdir -p env
                                      echo 'mv .env-backend-prod → env/.env-backend-prod'
                                      mv .env-backend-prod env/.env-backend-prod
                                      echo '=== REMOTE AFTER MV ==='
                                      ls -la env
                                      echo '=== START DOCKER COMPOSE ==='
                                      docker compose -f ${COMPOSE_FILE} \\
                                        --env-file env/.env-backend-prod \\
                                        up -d --build ${SERVICE_NAME}-prod
                                    """.stripIndent()
                                )
                            ],
                            verbose: true
                        )
                    ]
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
