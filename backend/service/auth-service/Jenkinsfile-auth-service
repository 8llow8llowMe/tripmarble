pipeline {
    agent any

    // GitHub PR Webhook으로부터 받은 환경변수
    environment {
        USER_NAME      = '' // pull_request.user.login
        IF_MERGED      = '' // pull_request.merged
        BASE_BRANCH    = '' // pull_request.base.ref
        LABEL          = '' // pull_request.labels[*].name
        SERVICE_NAME   = 'auth-service'
        IMAGE_NAME     = "tripmarble-${SERVICE_NAME}"
        DOCKERFILE     = 'auth-service.Dockerfile'
        COMPOSE_FILE   = 'docker-compose-auth-service.yml'
        ENV_SUBMODULE  = "${WORKSPACE}/backend/env/${SERVICE_NAME}" // submodule 경로
        REMOTE_DIR     = 'deploy/tripmarble/backend-app'
        SSH_CONFIG     = 'BackEnd Server SSH'
    }

    // triggers {
    //     GenericTrigger(
    //         genericVariables: [
    //             [key: 'USER_NAME',   value: '$.pull_request.user.login', expressionType: 'JSONPath'],
    //             [key: 'IF_MERGED',   value: '$.pull_request.merged',       expressionType: 'JSONPath'],
    //             [key: 'BASE_BRANCH', value: '$.pull_request.base.ref',     expressionType: 'JSONPath'],
    //             [key: 'LABEL',       value: '$.pull_request.labels[*].name', expressionType: 'JSONPath']
    //         ],
    //         causeString: 'Triggered by PR merge from ${USER_NAME}',
    //         token: 'jamjamnow-be-api-service',
    //         regexpFilterText: '$IF_MERGED $BASE_BRANCH $LABEL',
    //         regexpFilterExpression: '(?=.*true)(?=.*(develop|main))(?=.*backend-auth-service)'
    //     )
    // }

    stages {
        stage('Init & Submodule Update') {
            steps {
                checkout scm
                sh 'git submodule update --init --remote --checkout'
            }
        }

        stage('Build JAR') {
            steps {
                dir('backend/service/auth-service') {
                    sh 'chmod +x ../gradlew'
                    sh '../gradlew :service:auth-service:bootJar'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'backend/service/auth-service/build/libs/*.jar', allowEmptyArchive: false
                }
            }
        }

        // develop 브랜치일 때만 실행
        stage('Deploy to Dev') {
            when { expression { env.BASE_BRANCH == 'develop' } }
            steps {
                script {
                    // dev 환경 파일 & 컨테이너 이름
                    def envFile       = "${ENV_SUBMODULE}/.env-backend-dev"
                    def targetService = "${SERVICE_NAME}-dev"

                    sshPublisher publishers: [
                        sshPublisherDesc(
                            configName: SSH_CONFIG,
                            transfers: [
                                sshTransfer(
                                    sourceFiles: """
                                        backend/service/${SERVICE_NAME}/build/libs/*.jar,
                                        backend/service/${SERVICE_NAME}/${DOCKERFILE},
                                        backend/service/${SERVICE_NAME}/${COMPOSE_FILE},
                                        ${envFile}
                                    """,
                                    remoteDirectory: REMOTE_DIR,
                                    execCommand: """
                                        cd ~/${REMOTE_DIR}
                                        mkdir -p env
                                        mv ${envFile.tokenize('/').last()} env/${envFile.tokenize('/').last()}
                                        docker compose -f ${COMPOSE_FILE} --env-file env/${envFile.tokenize('/').last()} \
                                           up -d --build ${targetService}
                                    """
                                )
                            ],
                            verbose: true
                        )
                    ]
                }
            }
        }

        // main 브랜치일 때만 실행
        stage('Deploy to Prod') {
            when { expression { env.BASE_BRANCH == 'main' } }
            steps {
                script {
                    // prod 환경 파일 & 컨테이너 이름
                    def envFile       = "${ENV_SUBMODULE}/.env-backend-prod"
                    def targetService = "${SERVICE_NAME}-prod"

                    sshPublisher publishers: [
                        sshPublisherDesc(
                            configName: SSH_CONFIG,
                            transfers: [
                                sshTransfer(
                                    sourceFiles: """
                                        backend/service/${SERVICE_NAME}/build/libs/*.jar,
                                        backend/service/${SERVICE_NAME}/${DOCKERFILE},
                                        backend/service/${SERVICE_NAME}/${COMPOSE_FILE},
                                        ${envFile}
                                    """,
                                    remoteDirectory: REMOTE_DIR,
                                    execCommand: """
                                        cd ~/${REMOTE_DIR}
                                        mkdir -p env
                                        mv ${envFile.tokenize('/').last()} env/${envFile.tokenize('/').last()}
                                        docker compose -f ${COMPOSE_FILE} --env-file env/${envFile.tokenize('/').last()} \
                                           up -d --build ${targetService}
                                    """
                                )
                            ],
                            verbose: true
                        )
                    ]
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        failure {
            mail to: 'dev-team@example.com',
                 subject: "빌드 실패: ${SERVICE_NAME} on ${env.BASE_BRANCH}",
                 body: "빌드가 실패했습니다. 콘솔 로그를 확인하세요: ${env.BUILD_URL}"
        }
    }
}
