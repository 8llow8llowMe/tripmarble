pipeline {
    agent any

    environment {
        SERVICE_NAME   = 'auth-service'
        DOCKERFILE     = 'auth-service.Dockerfile'
        COMPOSE_FILE   = 'docker-compose-auth-service.yml'
        ENV_SUBMODULE  = "${WORKSPACE}/backend/env/${SERVICE_NAME}"
        REMOTE_DIR     = 'deploy/tripmarble/backend-app'
        SSH_CONFIG     = 'BackEnd Server SSH'
    }

    stages {
        stage('Init & Submodule Update') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: scm.branches,
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: [
                        [$class: 'SubmoduleOption',
                         recursiveSubmodules: true,
                         parentCredentials: true,
                         reference: '',
                         trackingSubmodules: false]
                    ]
                ])
            }
        }

        stage('Build JAR') {
            steps {
                dir('backend/service/auth-service') {
                    // gradlew 스크립트가 workspace/backend/gradlew 에 있기 때문에
                    sh 'chmod +x ../../gradlew'
                    sh '../../gradlew :service:auth-service:bootJar'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'backend/service/auth-service/build/libs/*.jar',
                                     allowEmptyArchive: false
                }
            }
        }

        stage('Deploy to Dev') {
            when { expression { env.BRANCH_NAME == 'develop' } }
            steps {
                script {
                    def envFile       = "${ENV_SUBMODULE}/.env-backend-dev"
                    def targetService = "${SERVICE_NAME}-dev"

                    sshPublisher publishers: [
                        sshPublisherDesc(
                            configName: SSH_CONFIG,
                            transfers: [
                                sshTransfer(
                                    sourceFiles: """
                                      backend/service/${SERVICE_NAME}/build/libs/*.jar,
                                      backend/service/${SERVICE_NAME}/${DOCKERFILE},
                                      backend/service/${SERVICE_NAME}/${COMPOSE_FILE},
                                      ${envFile}
                                    """,
                                    remoteDirectory: REMOTE_DIR,
                                    execCommand: """
                                      cd ~/${REMOTE_DIR}
                                      mkdir -p env
                                      mv ${envFile.tokenize('/').last()} env/
                                      docker compose -f ${COMPOSE_FILE} \
                                        --env-file env/${envFile.tokenize('/').last()} \
                                        up -d --build ${targetService}
                                    """
                                )
                            ],
                            verbose: true
                        )
                    ]
                }
            }
        }

        stage('Deploy to Prod') {
            when { expression { env.BRANCH_NAME == 'main' } }
            steps {
                script {
                    def envFile       = "${ENV_SUBMODULE}/.env-backend-prod"
                    def targetService = "${SERVICE_NAME}-prod"

                    sshPublisher publishers: [
                        sshPublisherDesc(
                            configName: SSH_CONFIG,
                            transfers: [
                                sshTransfer(
                                    sourceFiles: """
                                      backend/service/${SERVICE_NAME}/build/libs/*.jar,
                                      backend/service/${SERVICE_NAME}/${DOCKERFILE},
                                      backend/service/${SERVICE_NAME}/${COMPOSE_FILE},
                                      ${envFile}
                                    """,
                                    remoteDirectory: REMOTE_DIR,
                                    execCommand: """
                                      cd ~/${REMOTE_DIR}
                                      mkdir -p env
                                      mv ${envFile.tokenize('/').last()} env/
                                      docker compose -f ${COMPOSE_FILE} \
                                        --env-file env/${envFile.tokenize('/').last()} \
                                        up -d --build ${targetService}
                                    """
                                )
                            ],
                            verbose: true
                        )
                    ]
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        //failure {
        //    mail to: 'dev-team@example.com',
        //         subject: "빌드 실패: ${SERVICE_NAME} on ${env.BRANCH_NAME}",
        //         body: "빌드가 실패했습니다. 콘솔 로그를 확인하세요: ${env.BUILD_URL}"
        //}
    }
}
